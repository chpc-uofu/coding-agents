{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "shell": "bash",
  "plugins": [],
  "model": "chpc-vllm/Qwen/Qwen3.8-27B-FP8",
  "agents": {
    "title": {
      "model": "chpc-vllm/Qwen/Qwen3.8-27B-FP8"
    }
  },
  "providers": {
    "chpc-vllm": {
      "name": "CHPC Coder",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://nimbus.chpc.utah.edu:44242/v1",
        "provider": "chpc-vllm"
      },
      "models": {
        "Qwen/Qwen3.8-27B-FP8": {
          "name": "Qwen 3.8 27B",
          "limit": {
            "context": 262144,
            "output": 20000
          },
          "body": {
            "chat_template_kwargs": {
              "enable_thinking": false
            }
          }
        }
      }
    },
    "sandstone": {
      "name": "Sandstone",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://sandbox.ai.utah.edu/v1",
        "apiKey": "{env:SANDSTONE_KEY}",
        "provider": "sandstone"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "limit": {
            "context": 262144,
            "output": 32768
          }
        },
        "glm-5.3-flash": {
          "name": "GLM-5.3-Flash",
          "limit": {
            "context": 262144,
            "output": 32768
          }
        },
        "gpt-oss-120b": {
          "name": "gpt-oss-120b",
          "limit": {
            "context": 131072,
            "output": 32768
          }
        },
        "muse-glimmer-30b": {
          "name": "Muse Glimmer 30B",
          "limit": {
            "context": 131072,
            "output": 32768
          }
        },
        "gemma-4-26b": {
          "name": "Gemma 4 26B",
          "limit": {
            "context": 65536,
            "output": 16384
          }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "chpc-docs": {
        "type": "remote",
        "url": "http://nimbus.chpc.utah.edu:8000/mcp",
        "disabled": false
      }
    }
  },
  "policies": [
    {
      "action": "provider.use",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "provider.use",
      "resource": "chpc-vllm",
      "effect": "allow"
    },
    {
      "action": "provider.use",
      "resource": "openai",
      "effect": "allow"
    },
    {
      "action": "provider.use",
      "resource": "anthropic",
      "effect": "allow"
    },
    {
      "action": "provider.use",
      "resource": "google",
      "effect": "allow"
    },
    {
      "action": "provider.use",
      "resource": "sandstone",
      "effect": "allow"
    }
  ],
  "permissions": [
    {
      "action": "shell",
      "resource": "grep*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "rm*",
      "effect": "deny"
    }
  ],
  "instructions": [
    "/uufs/chpc.utah.edu/sys/etc/agents/AGENTS.md"
  ],
  "skills": [
    "/uufs/chpc.utah.edu/sys/etc/agents/skills"
  ]
}
