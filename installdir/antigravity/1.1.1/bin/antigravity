#!/bin/bash
# Antigravity CLI wrapper — enforces CHPC system-level restrictions.
#
# --sandbox enables OS-level isolation (Linux namespaces):
#   - No outbound network access
#   - Filesystem restricted to the workspace directory
#   - Bypass requires explicit user approval per command

LINKER=/uufs/chpc.utah.edu/sys/etc/agents/gemini_chpc_links.sh
# If the skills/ CHPC prompt linker script is present and readable, then source it. If not, then print message.
if [[ -r "$LINKER" ]]; then source "$LINKER"; else echo "CHPC: $LINKER not found; AGENTS.md/skills not linked" >&2; fi

exec antigravity-real --sandbox "$@"
